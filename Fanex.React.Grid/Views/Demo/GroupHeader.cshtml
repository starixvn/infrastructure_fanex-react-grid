@{
    ViewBag.Title = "Index";
    ViewBag.ActiveLink = "GroupHeader";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section js
{
    <script type="text/jsx" src="@Url.Content("~/Scripts/Demo/demo-group-header-grid.js")"></script>
}
<ul>
    <li>
        <h3>Demo - Group Headers</h3>
        <div>
            Num of row:
            <input type="text" id="num-of-row" value="220" />
            @*<input type="button" value="Server Render" onclick="getGridOptionsFromServer();" />
            <input type="button" value="Client Render" onclick="getGridOptionsFromClient();" />*@
            <input type="button" value="Render" onclick="getGridOptionsFromClient();" />
            <input type="button" value="Hide" onclick="hideDemo();" />
        </div>
        <div id="react-grid-server">
        </div>
        <div id="react-grid-client">
        </div>
    </li>
    <li>
        <h3>Source</h3>
        <div>            
            - set 2 properties:<br />
            <textarea rows="20" cols="120">
GroupHeaders: [
    {"Index":0,"Name":"ColumnIndex","MergeRowNumber":2,"Text":"#","TextAlign":2},
    {"Index":1,"Name":"ColumnDate","MergeRowNumber":2,"Text":"Date","TextAlign":2},
    {"Index":2,"Name":"ColumnText","MergeRowNumber":2,"Text":"Text","TextAlign":2},
    {"Index":3,"Name":"ColumnInteger","MergeColumnNumber":2,"Text":"Number","TextAlign":2},
    {"Index":5,"Name":"ColumnPercentage","MergeRowNumber":2,"Text":"Percentage","TextAlign":2}
],

HeaderColumns: [            
    {"Index":3,"Name":"ColumnInteger","Text":"Integer","TextAlign":2},
    {"Index":4,"Name":"ColumnDecimal","Text":"Decimal","TextAlign":2},
],
            </textarea>
        </div>
    </li>
</ul>
