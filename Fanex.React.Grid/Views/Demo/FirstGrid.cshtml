public JsonResult FirstPage(int numOfRow)
{
    var reactService = new FirstPageService();
    var data = reactService.GetReactGridOptions(numOfRow);
    var json = Json(data);
    json.MaxJsonLength = int.MaxValue;
    return json;
}
public GridOptions GetReactGridOptions(int numOfRow)
{
    var bodyRows = GetBodyRows(numOfRow);
    var gridOptions = new GridOptions
    {
        NoDataText = "No data",
        MaxContentHeight = 250,
        HeaderStyle = Fanex.React.Options.Formatter.HeaderStyle.HeaderOneLine,
        HeaderColumns = GetHeader(),
        BodyRows = bodyRows,
    };

    return gridOptions;
}

private List<HeaderColumns> GetHeader()
{
    var headers = new List<HeaderColumns>();
    headers.Add(new HeaderColumns { Index = 0, Name = "ColumnIndex", TextAlign = TextAlign.Center, Text = "#"});
    headers.Add(new HeaderColumns { Index = 1, Name = "ColumnDate", TextAlign = TextAlign.Center, Text = "Date"});
    headers.Add(new HeaderColumns { Index = 2, Name = "ColumnText", TextAlign = TextAlign.Center, Text = "Text"});
    headers.Add(new HeaderColumns { Index = 3, Name = "ColumnInteger", TextAlign = TextAlign.Center, Text = "Integer"});
    headers.Add(new HeaderColumns { Index = 4, Name = "ColumnDecimal", TextAlign = TextAlign.Center, Text = "Decimal"});
    headers.Add(new HeaderColumns { Index = 5, Name = "ColumnPercentage", TextAlign = TextAlign.Center, Text = "Percentage"});
    return headers;
}

private List<Row> GetBodyRows(int numOfRow)
{
    var rows = new List<Row>();
    for (int i = 0; i < numOfRow; i++)
    {
        var columns = new List<Column>();
        columns.Add(new Column() { Index = 0, TextAlign = TextAlign.Center, CellDataType = CellDataType.Integer, Name = "ColumnIndex", Value = i + 1 });
        columns.Add(new Column() { Index = 1, TextAlign = TextAlign.Center, CellDataType = CellDataType.DateTimeMMMdyyyy, Name = "ColumnDate", Value = RandomDate() });
        columns.Add(new Column() { Index = 2, TextAlign = TextAlign.Left, CellDataType = CellDataType.Text, Name = "ColumnText", Value = i.ToString() + RandomText() });
        columns.Add(new Column() { Index = 3, CellDataType = CellDataType.Integer, Name = "ColumnInteger", Value = RandomInt() });
        columns.Add(new Column() { Index = 4, CellDataType = CellDataType.Decimal, Name = "ColumnDecimal", Value = (i % 2 == 0 ? 1 : -1) * RandomDecimal() });
        columns.Add(new Column() { Index = 5, CellDataType = CellDataType.Percentage, Name = "ColumnPercentage", Value = RandomMargin() });
        rows.Add(new Row() { Columns = columns, RowIndex = i });
    }

    return rows;
}

private List<Row> GetFooterRows()
{
    var rows = new List<Row>();
    for (int i = 0; i < 2; i++)
    {
        var columns = new List<Column>();
        columns.Add(new Column() { Index = 0, TextAlign = TextAlign.Center, CellDataType = CellDataType.Text, Value = "Total" });
        columns.Add(new Column() { Index = 1, TextAlign = TextAlign.Center, CellDataType = CellDataType.DateTimeMMMdyyyy, Value = RandomDate() });
        columns.Add(new Column() { Index = 2, TextAlign = TextAlign.Right, CellDataType = CellDataType.Integer, Value = RandomInt() });
        columns.Add(new Column() { Index = 3, TextAlign = TextAlign.Right, CellDataType = CellDataType.Decimal, Value = RandomDecimal() });
        columns.Add(new Column() { Index = 4, TextAlign = TextAlign.Right, CellDataType = CellDataType.Decimal, Value = RandomDecimal() });
        columns.Add(new Column() { Index = 5, TextAlign = TextAlign.Right, CellDataType = CellDataType.Percentage, Value = RandomMargin() });
        rows.Add(new Row() { Columns = columns, RowIndex = i });
    }

    return rows;
}
