                <textarea rows="10" cols="100" readonly="readonly">
public JsonResult FirstPage(int numOfRow)
{
    var reactService = new FirstPageService();
    var data = reactService.GetReactGridOptions(numOfRow);
    var json = Json(data);
    json.MaxJsonLength = int.MaxValue;
    return json;
}
public GridOptions GetReactGridOptions(int numOfRow)
{
    var bodyRows = GetBodyRows(numOfRow);
    var gridOptions = new GridOptions
    {
        NoDataText = "No data",
        MaxContentHeight = 250,
        HeaderStyle = Fanex.React.Options.Formatter.HeaderStyle.HeaderOneLine,
        HeaderColumns = GetHeader(),
        BodyRows = bodyRows,
    };

    return gridOptions;
}

private List<HeaderColumns> GetHeader()
{
    var headers = new List<HeaderColumns>();
    var colindex = 0;

    headers.Add(new HeaderColumns { Index = colindex++, Name = "ColumnIndex", TextAlign = TextAlign.Center, Text = "#", Width = 60 });
    headers.Add(new HeaderColumns { Index = colindex++, Name = "ColumnDate", TextAlign = TextAlign.Center, Text = "Date", Width = 100 });
    headers.Add(new HeaderColumns { Index = colindex++, Name = "ColumnText", TextAlign = TextAlign.Center, Text = "Text", Width = 250 });
    headers.Add(new HeaderColumns { Index = colindex++, Name = "ColumnInteger", TextAlign = TextAlign.Center, Text = "Integer", Width = 100 });
    headers.Add(new HeaderColumns { Index = colindex++, Name = "ColumnDecimal", TextAlign = TextAlign.Center, Text = "Decimal", Width = 150 });
    headers.Add(new HeaderColumns { Index = colindex++, Name = "ColumnPercentage", TextAlign = TextAlign.Center, Text = "Percentage", Width = 150 });

    return headers;
}

private List<Row> GetBodyRows(int numOfRow)
{
    var rows = new List<Row>();
    for (int i = 0; i < numOfRow; i++)
    {
        var colindex = 0;
        var columns = new List<Column>();
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Center, CellDataType = CellDataType.Integer, Name = "ColumnIndex", Value = i + 1 });
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Center, CellDataType = CellDataType.DateTimeMMMdyyyy, Name = "ColumnDate", Value = RandomDate() });
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Left, CellDataType = CellDataType.Text, Name = "ColumnText", Value = i.ToString() + RandomText() });
        columns.Add(new Column() { Index = colindex++, CellDataType = CellDataType.Integer, Name = "ColumnInteger", Value = RandomInt() });
        columns.Add(new Column() { Index = colindex++, CellDataType = CellDataType.Decimal, Name = "ColumnDecimal", Value = (i % 2 == 0 ? 1 : -1) * RandomDecimal() });
        columns.Add(new Column() { Index = colindex++, CellDataType = CellDataType.Percentage, Name = "ColumnPercentage", Value = RandomMargin() });
        rows.Add(new Row() { Columns = columns, RowIndex = i });
    }

    return rows;
}

private List<Row> GetFooterRows()
{
    var rows = new List<Row>();
    for (int i = 0; i < 2; i++)
    {
        var colindex = 0;
        var columns = new List<Column>();
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Center, CellDataType = CellDataType.Text, Name = "ColumnIndex", Value = "Total" });
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Center, CellDataType = CellDataType.DateTimeMMMdyyyy, Name = "ColumnDate", Value = RandomDate() });
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Right, CellDataType = CellDataType.Integer, Name = "ColumnText", Value = RandomInt(), Width = 100 });
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Right, CellDataType = CellDataType.Decimal, Name = "ColumnInteger", Value = RandomDecimal(), Width = 150 });
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Right, CellDataType = CellDataType.Decimal, Name = "ColumnDecimal", Value = RandomDecimal(), Width = 150 });
        columns.Add(new Column() { Index = colindex++, TextAlign = TextAlign.Right, CellDataType = CellDataType.Percentage, Name = "ColumnPercentage", Value = RandomMargin(), Width = 100 });
        rows.Add(new Row() { Columns = columns, RowIndex = i });
    }

    return rows;
}
                </textarea><br />
                - render component:<br />
                <textarea rows="8" cols="100" readonly="readonly">
var criteria = new FormData();
criteria.append('numOfRow', $("#num-of-row").val());
var xhr = new XMLHttpRequest();
xhr.open('post', getClientUrl("demo/FirstPage"), true);
xhr.onload = function () {
    var gridOptions = JSON.parse(xhr.responseText);
    React.render(
        <ReactGrid gridOptions={gridOptions} containerId='react-grid' />,
        document.getElementById('react-grid-server')
    );
};
xhr.send(criteria);
