@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    <link href="@Url.Content("~/src/fanex.react.grid.css")" type="text/css" rel="stylesheet" />
}
@section jsx
{
    <script type="text/jsx" src="@Url.Content("~/src/fanex.react.grid.js")"></script>
}
@section js
{
    <script type="text/jsx" src="@Url.Content("~/Scripts/Demo/demo-client-paging.js")"></script>
}
<ul>
    <li>
        <h2>Demo</h2>
        <div>
            Num of row:
            <input type="text" id="num-of-row" value="220" />
            @*<input type="button" value="Server Render" onclick="getGridOptionsFromServer();" />
            <input type="button" value="Client Render" onclick="getGridOptionsFromClient();" />*@
            <input type="button" value="Render" onclick="getGridOptionsFromClient();" />
            <input type="button" value="Hide" onclick="hideDemo();" />
        </div>
        <div id="react-grid-server">
        </div>
        <div id="react-grid-client">
        </div>
    </li>
    <li>
        <h2>Source</h2>
        <div>            
            - set these properties in grid options:<br />
            <textarea rows="10" cols="120" readonly="readonly">
IsPaging: true,
IsServerPaging: false,
PagingOptions: {
    PageIndex: 0,
    PageSize: 100,
    PageSizeList: [50, 100, 200, 500],
    PagingCallBack: null,    
},
            </textarea>
        </div>
    </li>
</ul>
