@{
    ViewBag.Title = "FreezeColumn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section js
{
    <script type="text/jsx" src="@Url.Content("~/Scripts/Utility/demo-freeze-column.js")"></script>
}
<ul>
    <li>
        <h3>
            Demo - Freeze Column</h3>
        <div>
            Num of row:
